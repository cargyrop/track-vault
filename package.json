{
  "name": "trackvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, ad-light music library that tracks YouTube sources without downloading video.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^27.4.0",
    "sql.js": "^1.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
